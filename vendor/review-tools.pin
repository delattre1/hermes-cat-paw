# CLIs baked into the Hermes Cat Paw image at docker build.
# Playbooks stay a runtime clone (cybersecurity-skills.pin).
#
# kind=tar  GitHub tarball; installer finds the binary named `tool`
# kind=zip  zip archive; same payload picker
# kind=bin  raw binary
# kind=uv   uv tool install tool==version
# kind=npm  npm install -g tool@version
# kind=apt  Debian package (name = tool)
# kind=file downloaded to `path=` (wordlists). Same bytes on amd64/arm64.
#
# Live scanners are in the image so the agent is ready without apt-get.
# When Latch is connected, live packets at an owned target still go through
# Latch (owner IP + approval). No permission in chat → no probe.

tool=jq
kind=apt

tool=shellcheck
kind=apt

tool=unzip
kind=apt

tool=nmap
kind=apt

tool=masscan
kind=apt

tool=sqlmap
kind=apt

tool=hashcat
kind=apt

tool=bind9-dnsutils
kind=apt

tool=whois
kind=apt

tool=netcat-openbsd
kind=apt

tool=tcpdump
kind=apt

tool=libpcap0.8
kind=apt

tool=dirb
kind=apt

