#!/bin/sh
PATH=/command:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin
export PATH
PLOW_AGENT_TOKEN=$(cat /run/s6/container_environment/PLOW_AGENT_TOKEN 2>/dev/null || true)
AGENT_ID=$(cat /run/s6/container_environment/AGENT_ID 2>/dev/null || true)
HERMES_HOME=/var/lib/hermes
PYTHON=/opt/hermes/.venv/bin/python3
CLIENT=/opt/plow/agent-index-client.py
export AGENT_ID HERMES_HOME

if [ -z "$AGENT_ID" ]; then
  echo "agent-index: no AGENT_ID; standing down instead of guessing" >&2
  exec sleep 86400
fi

as_hermes() {
  /command/s6-setuidgid hermes env HOME="$HERMES_HOME" HERMES_HOME="$HERMES_HOME" AGENT_ID="$AGENT_ID" "$@"
}

# /var/lib/hermes is sticky (3770 root:hermes). A ledger written by
# `docker compose exec` (root by default) cannot be replaced by uid hermes:
# read fails with EACCES, os.replace fails with EPERM. Repair as root
# before every report. Also refresh product skills into the named volume,
# which otherwise keeps the copy from first boot.
prepare_home() {
  for f in \
    "$HERMES_HOME/.agent-index-state.json" \
    "$HERMES_HOME/.agent-index-state.json.new" \
    "$HERMES_HOME/.agent-index.json" \
    "$HERMES_HOME/.agent-index.lock"
  do
    if [ -e "$f" ]; then
      chown hermes:hermes "$f" || true
    fi
  done
  src_root=/opt/hermes/skills
  dst_root="$HERMES_HOME/skills"
  if [ -d "$src_root" ]; then
    mkdir -p "$dst_root"
    for src in "$src_root"/*/SKILL.md; do
      [ -f "$src" ] || continue
      name=$(basename "$(dirname "$src")")
      mkdir -p "$dst_root/$name"
      cp -f "$src" "$dst_root/$name/SKILL.md"
      chown hermes:hermes "$dst_root/$name" "$dst_root/$name/SKILL.md" || true
      chmod 0755 "$dst_root/$name" || true
      chmod 0644 "$dst_root/$name/SKILL.md" || true
    done
    # Retired overlay skill. The volume would otherwise keep first-boot copy.
    if [ -d "$dst_root/hermes-cat-paw-context" ]; then
      rm -rf "$dst_root/hermes-cat-paw-context"
    fi
  fi
}

wait_for_store() {
  n=0
  while [ ! -s "$HERMES_HOME/state.db" ]; do
    n=$((n + 1))
    if [ "$n" -gt 90 ]; then
      echo "agent-index: Hermes state.db still missing; will retry next hour" >&2
      return 1
    fi
    if [ "$n" -eq 1 ] || [ $((n % 15)) -eq 0 ]; then
      echo "agent-index: waiting for Hermes state.db (${n}/90)" >&2
    fi
    sleep 2
  done
  return 0
}

while :; do
  prepare_home
  if ! wait_for_store; then
    /bin/sleep 3600
    continue
  fi
  as_hermes "$PYTHON" "$CLIENT" status >/dev/null
  status=$?
  if [ "$status" -eq 3 ]; then
    as_hermes env PLOW_AGENT_TOKEN="$PLOW_AGENT_TOKEN" \
      "$PYTHON" "$CLIENT" --register --agent "$AGENT_ID" \
      --name "Hermes Cat Paw" \
      --blurb "Human-approved computer control for Windows, Linux, and Omarchy through Plow Latch." \
      --runtime "Hermes / Plow Latch" \
      --repo "https://github.com/kumanaya/hermes-cat-paw" \
      --install-url "https://github.com/kumanaya/hermes-cat-paw/blob/main/docs/INSTALL.md" \
      --video "KjWFtHh0EFE" \
      --image "https://raw.githubusercontent.com/kumanaya/hermes-cat-paw/main/hackathon-banner.png" \
      --image "https://raw.githubusercontent.com/kumanaya/hermes-cat-paw/main/docs/images/real-usage.png" >/dev/null || {
        echo "agent-index: registration failed; not reporting this hour" >&2
        /bin/sleep 3600
        continue
      }
  elif [ "$status" -ne 0 ]; then
    echo "agent-index: status exited $status; not reporting this hour" >&2
    /bin/sleep 3600
    continue
  fi
  as_hermes "$PYTHON" "$CLIENT" \
    || echo "agent-index: reporter exited non-zero" >&2
  /bin/sleep 3600
done
